# ==============================================================================
# Koode AI (കൂടെ AI) — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your values.
# IMPORTANT: Never commit .env with real secret keys to source control.

# --- Local Reasoning Model (Ollama + Gemma 3) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_SECONDS=90.0
# Keep the model loaded between requests (avoids a ~50s cold start)
OLLAMA_KEEP_ALIVE=30m

# --- Sarvam AI Speech-to-Text (Cloud STT for Malayalam / Indian Languages) ---
# Sign up at https://sarvam.ai to obtain your API subscription key
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_MODEL=saaras:v4
SARVAM_MODE=transcribe
SARVAM_TIMEOUT_SECONDS=25.0

# --- Audio Constraints ---
MAX_AUDIO_SIZE_BYTES=10485760
MAX_AUDIO_DURATION_SECONDS=30.0
